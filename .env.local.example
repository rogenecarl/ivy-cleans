# Copy to .env.local (gitignored) and fill in. Next.js loads .env.local
# automatically for `next dev` and `next start`; on Vercel these are set as
# Project → Settings → Environment Variables instead.
#
# This file holds everything EXCEPT the database credentials — those live in
# .env.example / .env instead, because the Prisma CLI (`prisma db push`,
# `prisma migrate`, etc.) only auto-loads a file literally named `.env`, never
# `.env.local`. See .env.example for the full explanation.

# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY — required for REAL city generation in the admin.
#
# Without it, AnthropicModelClient throws at construction with a clear message
# rather than failing mid-stage. The pipeline is the only thing that uses it.
#
# SET A SPEND CAP ON THIS KEY IN THE ANTHROPIC CONSOLE before using it
# (Console → Settings → Limits): a full city is a handful of calls, but every
# stage has a Retry button and nothing in this app enforces a budget. A cap is
# the only backstop against a stuck retry loop.
#
# Never commit the real value — `.env*` is gitignored (this example file is
# the single negated exception).
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# STUB_MODEL — set to 1 to replace every model call with canned fixture data
# (tests/fixtures/stub-pipeline.json, the fictional city "Stubville"), parsed
# through the same zod schemas as real output. No network, no spend.
#
# Used by the unit tests and required by scripts/admin-e2e.mjs:
#     STUB_MODEL=1 pnpm dev --port 3100
#     node scripts/admin-e2e.mjs
#
# NEVER set this in production — every generated city would come out as
# Stubville copy.
# ─────────────────────────────────────────────────────────────────────────────
# STUB_MODEL=1

# ─────────────────────────────────────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN — optional, NOT YET IN USE.
#
# When set, the content store reads city documents from Vercel Blob instead of
# the repo's content/ directory (src/content/store.ts). Until then a published
# city is only durable once its content/*.json files are committed and
# redeployed. Leave unset for local work.
# ─────────────────────────────────────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# LEADS ENVIRONMENT: absent and BLANK mean the same thing.
#
# All three of the variables below are resolved in exactly one place,
# src/leads/env.ts, which treats an unset variable and a blank/whitespace-only
# one identically ("not configured") and logs each missing one ONCE at boot.
# A half-filled line here — `IP_HASH_SALT=` with nothing after it, which is
# what copying this file gives you — is therefore safe: it degrades one
# feature and says so, instead of silently refusing every customer.
# ─────────────────────────────────────────────────────────────────────────────

# Resend
RESEND_API_KEY=

# The verified sending address, e.g. leads@<verified-domain>. Not configured =>
# no notification email is sent and every lead is flagged "email not sent" in
# the dashboard with that reason. The lead itself is still captured.
LEADS_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# LEADS_DASHBOARD_ORIGIN — the canonical production origin, e.g.
# https://ivycleans.com (no trailing slash). Used ONLY to build the "Open in
# dashboard" link placed in the lead notification email sent to the operator
# (src/app/(sites)/[city]/lead-actions.ts -> src/leads/email.ts).
#
# Deliberately NOT derived from the request's Host header: a URL that lands in
# an outbound email must never be built from request input, since the
# operator clicks it. If this is unset, the email is still sent — it just
# omits the dashboard link rather than guess at one (fail closed).
# ─────────────────────────────────────────────────────────────────────────────
LEADS_DASHBOARD_ORIGIN=

# Random, stable per environment. Changing it silently resets rate limiting.
# Not configured => leads are stored with NO ipHash, which disables per-IP rate
# limiting on the public forms. Submissions are still captured and still
# emailed: losing a real customer would be far worse than losing a spam
# control. There is deliberately no default value — a fallback string in the
# repository would mean every deployment that forgot this hashed real customer
# IPs with a value anyone can read.
IP_HASH_SALT=

# Local and test only: routes every notification email to an in-memory sink.
STUB_EMAIL=1
