# Copy to .env.local. DB credentials go in .env, see example.env.

# Required for city generation. Set a spend cap on the key.
ANTHROPIC_API_KEY=sk-ant-...

# Use fixtures instead of real model calls. Not for production.
# STUB_MODEL=1

# Unused for now.
# BLOB_READ_WRITE_TOKEN=

RESEND_API_KEY=

# e.g. leads@yourdomain.com
LEADS_FROM_EMAIL=

# e.g. https://ivycleans.com, no trailing slash
LEADS_DASHBOARD_ORIGIN=

# Random string, keep it stable.
IP_HASH_SALT=

# Local and test only.
STUB_EMAIL=1
