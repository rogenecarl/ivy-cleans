# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# per-round fidelity-probe scratch dirs (live/local DOM dumps + screenshots).
# Not just housekeeping: Tailwind v4 auto-scans every non-ignored file in the
# project, and these dumps record each element's full `class` attribute — so an
# un-ignored fidelity-*/ directory feeds our own class strings back into the
# content scan and bakes dead utilities into the shared CSS chunk.
/fidelity-*/
