# Copy to .env. Everything else goes in .env.local, see .env.local.example.
# The Prisma CLI only reads .env, which is why the database URL lives here.

# Neon pooled connection string, the host contains "-pooler".
DATABASE_URL=

# Leave unset. Set to 1 only if connections to a dual-stack host time out
# while connecting straight to its IPv4 address works.
DB_DISABLE_HAPPY_EYEBALLS=
